// Dynamic face-point distortion: one circular zone per (detected face x enabled point).
// The CPU fills zone_data[] with up to MAX_ZONES entries (x/y centre percent, radius percent,
// magnitude) and the pixel shader applies the original distortZone math in a loop. The
// distortZone function and the aspect-correction model are byte-identical to the original
// 6-zone shader (see data/original-6-zone.effect); only the way zones are enumerated changed.
uniform float4x4 ViewProj;
uniform texture2d image;
uniform float2 uv_size;
uniform float elapsed_time;
uniform bool animate = false;
uniform int zone_count = 0;
// Sized for maxFaces (8) x 3 points. Keep in sync with opa::maxZones in src/filter.hpp.
uniform float4 zone_data[24];
// Independent options that can be combined with the distortion:
//   blur_faces   - blur the whole detected face box
//   debug_points - overlay the detection box and the three point anchors (eyes / nose / mouth)
uniform bool blur_faces = false;
uniform float blur_px = 24.0;
uniform int face_count = 0;
uniform float4 face_box[8];       // cx, cy, w, h (percent of frame)
uniform bool debug_points = false;
uniform int marker_count = 0;
// x, y (centre %), z (size %), w (marker index): 0 = eyes, 1 = nose, 2 = mouth.
// Sized for maxFaces (8) x 3 anchors. Keep in sync with opa::maxMarkers.
uniform float4 marker_data[24];

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v) {
    v.pos = mul(float4(v.pos.xyz, 1.0), ViewProj);
    return v;
}

// ------------------------------------------------------------
// Original Radegast Stravinsky zone distortion (unchanged math).
// ------------------------------------------------------------
float2 distortZone(
    float2 uv,
    float2 center,
    float radius,
    float magnitude
)
{
    if (radius <= 0.00001 || magnitude == 0.0)
        return uv;

    float dist = distance(uv, center);
    if (dist < radius)
    {
        float percent = dist / radius;
        if (magnitude > 0.0)
        {
            uv = (uv - center) *
                lerp(
                    1.0,
                    smoothstep(0.0, radius / max(dist, 0.00001), percent),
                    magnitude * 0.75
                );
        }
        else
        {
            uv = (uv - center) *
                lerp(
                    1.0,
                    pow(percent, 1.0 + magnitude * 0.75) * radius / max(dist, 0.00001),
                    1.0 - percent
                );
        }
        uv += center;
    }
    return uv;
}

// ------------------------------------------------------------
// Debug marker colours: 0 = eyes, 1 = nose, 2 = mouth.
// ------------------------------------------------------------
float3 markerColor(int idx)
{
    if (idx == 0)
        return float3(1.0, 0.25, 0.25); // eyes  - red
    if (idx == 1)
        return float3(0.25, 1.0, 0.25); // nose  - green
    return float3(0.3, 0.6, 1.0);       // mouth - blue
}

// Soft outline of an axis-aligned rectangle centred at c with half-extents half (signed distance).
float rectOutline(float2 p, float2 c, float2 half, float w)
{
    float2 d = abs(p - c) - half;
    float dist = length(max(d, 0.0)) + min(max(d.x, d.y), 0.0);
    return 1.0 - smoothstep(0.0, w, abs(dist));
}

// ------------------------------------------------------------
// MAIN
// ------------------------------------------------------------
float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float2 hw = uv_size;

    // Aspect ratio correction
    float ar = hw.y / hw.x;

    // Aspect-corrected working space.
    float2 correctedUV = uv;
    correctedUV.x /= ar;

    // ---------- DISTORTION: independent, driven by the point magnitudes ----------
    for (int i = 0; i < zone_count; i++)
    {
        float4 z = zone_data[i];
        float2 center = float2(z.x / 100.0, z.y / 100.0);
        center.x /= ar;
        float mag = z.w;
        if (animate)
            mag *= sin(radians(elapsed_time * 20.0));
        correctedUV = distortZone(correctedUV, center, z.z / 100.0, mag);
    }

    // Sample the (distortion-applied) image. correctedUV is aspect-corrected, so undo x for sampling.
    float2 sampleUV = float2(correctedUV.x * ar, correctedUV.y);
    float4 color = image.Sample(textureSampler, sampleUV);

    // ---------- FACE BLUR: independent option, blurs the whole face box ----------
    if (blur_faces && face_count > 0)
    {
        float mask = 0.0;
        for (int i = 0; i < face_count; i++)
        {
            float4 b = face_box[i];
            float2 c = float2(b.x / 100.0, b.y / 100.0);
            c.x /= ar;
            float2 half = float2(b.z / 100.0 * 0.5, b.w / 100.0 * 0.5);
            half.x /= ar;
            float2 q = (correctedUV - c) / (half * 1.15 + float2(0.0001, 0.0001));
            mask = max(mask, 1.0 - smoothstep(0.75, 1.0, max(abs(q.x), abs(q.y))));
        }
        if (mask > 0.001)
        {
            float2 texel = 1.0 / uv_size;
            float4 sum = float4(0.0, 0.0, 0.0, 0.0);
            for (int yy = -2; yy <= 2; yy++)
                for (int xx = -2; xx <= 2; xx++)
                    sum += image.Sample(textureSampler,
                                        sampleUV + float2(xx, yy) * blur_px * 0.5 * texel);
            color = lerp(color, sum / 25.0, mask);
        }
    }

    // ---------- DEBUG POINTS: independent option ----------
    if (debug_points)
    {
        for (int i = 0; i < marker_count; i++)
        {
            float4 m = marker_data[i];
            float2 c = float2(m.x / 100.0, m.y / 100.0);
            c.x /= ar;
            float size = max(m.z, 0.4) / 100.0;
            float d = distance(correctedUV, c);
            float ring = 1.0 - smoothstep(size, size * 1.35, d);
            float dot = 1.0 - smoothstep(size * 0.35, size * 0.55, d);
            int idx = (int)m.w;
            float3 col = markerColor(idx);
            color.rgb = lerp(color.rgb, col, clamp(ring * 0.45 + dot, 0.0, 1.0));
        }
        // Per-face detection box (light grey outline). The three point anchors are drawn as
        // markers above; debug mode overlays nothing else.
        for (int f = 0; f < face_count; f++)
        {
            float4 b = face_box[f]; // b = (cx, cy, w, h), percent of frame
            float2 c = float2(b.x / 100.0, b.y / 100.0);
            c.x /= ar;
            float2 he = float2(b.z / 100.0 * 0.5, b.w / 100.0 * 0.5);
            he.x /= ar;
            float lineW = max(b.w, 1.0) / 100.0 * 0.006; // thin lines

            // detection box outline
            color.rgb = lerp(color.rgb, float3(0.85, 0.85, 0.9),
                             rectOutline(correctedUV, c, he, max(lineW, 0.0012)) * 0.5);
        }
    }

    return color;
}

technique Draw {
    pass {
        vertex_shader = VSDefault(v);
        pixel_shader = mainImage(v_in);
    }
}
